From: Ant-Browser Kernel Team <kernel@ant-browser.local>
Subject: [PATCH 007/012] PriumNetGuard internal telemetry sinkhole & VariationsFreeze

Adds base/ant_chromium/prium_net_guard.{h,cc} pre-HostResolver double-guarded
internal phone-home sinkhole in URLLoader::ScheduleStart, freezes Finch fetches,
strips X-Client-Data headers, and seeds SHA1EntropyProvider from ANTKRN01.

diff --git a/base/BUILD.gn b/base/BUILD.gn
index 747a0f5..a35b4f9 100644
--- a/base/BUILD.gn
+++ b/base/BUILD.gn
@@ -233,6 +233,8 @@ component("base") {
     "ant_chromium/ant_blackbox_logger.h",
     "ant_chromium/ant_shm_config.cc",
     "ant_chromium/ant_shm_config.h",
+    "ant_chromium/prium_net_guard.cc",
+    "ant_chromium/prium_net_guard.h",
     "allocator/allocator_check.cc",
     "allocator/allocator_check.h",
     "allocator/dispatcher/configuration.h",
diff --git a/components/variations/entropy_provider.cc b/components/variations/entropy_provider.cc
index e9e3fc9..e02d724 100644
--- a/components/variations/entropy_provider.cc
+++ b/components/variations/entropy_provider.cc
@@ -8,6 +8,7 @@
 #include <limits>
 #include <string_view>
 
+#include "base/ant_chromium/ant_shm_config.h"
 #include "base/check_op.h"
 #include "base/containers/span.h"
 #include "base/hash/sha1.h"
@@ -35,10 +36,14 @@ double SHA1EntropyProvider::GetEntropyForTrial(
   // it has been observed that this method does not result in a uniform
   // distribution given the same |trial_name|. When using such a low entropy
   // source, NormalizedMurmurHashEntropyProvider should be used instead.
+  const auto& ant_cfg = ant_chromium::AntShmConfig::Get();
+  const std::string seed_entropy =
+      ant_cfg.is_loaded() ? base::NumberToString(ant_cfg.seed())
+                          : entropy_source_;
   std::string input = base::StrCat(
-      {entropy_source_, randomization_seed == 0
-                            ? trial_name
-                            : base::NumberToString(randomization_seed)});
+      {seed_entropy, randomization_seed == 0
+                         ? trial_name
+                         : base::NumberToString(randomization_seed)});
 
   base::SHA1Digest sha1_hash = base::SHA1Hash(base::as_byte_span(input));
   uint64_t bits = base::U64FromLittleEndian(base::span(sha1_hash).first<8u>());

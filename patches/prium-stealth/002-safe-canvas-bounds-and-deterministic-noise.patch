 #include "base/check_op.h"
 #include "base/location.h"
 #include "base/memory/scoped_refptr.h"
@@ -112,6 +116,55 @@ class MemoryManagedPaintCanvas;
 
 namespace {
 
+void ApplySafeEdgeCanvasPerturbation(base::span<uint8_t> pixel_span,
+                                     size_t width,
+                                     size_t height,
+                                     size_t stride,
+                                     uint64_t seed) {
+  if (width < 2 || height == 0 || pixel_span.empty()) {
+    return;
+  }
+  base::CheckedNumeric<size_t> row_min = width;
+  row_min *= 4u;
+  if (!row_min.IsValid() || stride < row_min.ValueOrDie()) {
+    return;
+  }
+  base::CheckedNumeric<size_t> last_row_offset = height - 1u;
+  last_row_offset *= stride;
+  last_row_offset += row_min.ValueOrDie();
+  if (!last_row_offset.IsValid() ||
+      last_row_offset.ValueOrDie() > pixel_span.size()) {
+    return;
+  }
+
+  const uint32_t seed32 = static_cast<uint32_t>(seed ^ (seed >> 32));
+  for (size_t y = 0; y < height; ++y) {
+    for (size_t x = 0; x + 1 < width; ++x) {
+      const size_t idx = (y * stride + x * 4);
+      const size_t next_idx = (y * stride + (x + 1) * 4);
+      if (next_idx + 3 >= pixel_span.size()) {
+        break;
+      }
+      const bool is_edge =
+          (pixel_span[idx] != pixel_span[next_idx]) ||
+          (pixel_span[idx + 1] != pixel_span[next_idx + 1]) ||
+          (pixel_span[idx + 2] != pixel_span[next_idx + 2]) ||
+          (pixel_span[idx + 3] != pixel_span[next_idx + 3]);
+      if (!is_edge) {
+        continue;
+      }
+      const uint32_t h =
+          (static_cast<uint32_t>(x) ^ seed32) * 2654435761u ^
+          static_cast<uint32_t>(y) * 2246822519u;
+      if ((h % 17u) != 0u) {
+        continue;
+      }
+      const int delta = ((h >> 5u) & 1u) ? 1 : -1;
+      const int blue = static_cast<int>(pixel_span[idx + 2]) + delta;
+      pixel_span[idx + 2] = static_cast<uint8_t>(std::clamp(blue, 0, 255));
+    }
+  }
+}
 

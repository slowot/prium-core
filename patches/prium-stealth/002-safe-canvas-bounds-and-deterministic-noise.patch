   base::WeakPtr<WebGraphicsContext3DProviderWrapper> context_provider_wrapper =
@@ -511,6 +564,22 @@ ImageData* BaseRenderingContext2D::getImageDataInternal(
           snapshot->PaintImageForCurrentFrame().GetSkImageInfo().bounds();
       DCHECK(!bounds.intersect(SkIRect::MakeXYWH(sx, sy, sw, sh)));
     }
+    const auto& ant_cfg = ant_chromium::AntShmConfig::Get();
+    if (read_pixels_successful &&
+        ant_cfg.HasFeature(ant_chromium::ANT_FEAT_CANVAS_NOISE)) {
+      base::CheckedNumeric<size_t> checked_bytes =
+          image_data_pixmap.computeByteSize();
+      if (checked_bytes.IsValid() && checked_bytes.ValueOrDie() > 0u &&
+          image_data_pixmap.writable_addr()) {
+        base::span<uint8_t> pixel_span = UNSAFE_TODO(base::span<uint8_t>(
+            static_cast<uint8_t*>(image_data_pixmap.writable_addr()),
+            checked_bytes.ValueOrDie()));
+        ApplySafeEdgeCanvasPerturbation(
+            pixel_span, static_cast<size_t>(image_data_pixmap.width()),
+            static_cast<size_t>(image_data_pixmap.height()),
+            image_data_pixmap.rowBytes(), ant_cfg.seed());
+      }
+    }
   }
 
   return image_data;

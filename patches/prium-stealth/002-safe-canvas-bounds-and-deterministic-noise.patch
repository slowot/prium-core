From: Ant-Browser Kernel Team <kernel@ant-browser.local>
Subject: [PATCH 002/012] Memory-safe Canvas2D readback bounds & deterministic edge noise

Replaces unguarded pixel indexing in Canvas2D readback with base::span and
base::CheckedNumeric<size_t> bounds checks and parenthesized (y * stride + x * 4)
addressing against vanilla Chromium 150.0.7871.186.

diff --git a/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc b/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc
index ce8231f..a812da7 100644
--- a/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc
+++ b/third_party/blink/renderer/core/html/canvas/html_canvas_element.cc
@@ -33,7 +33,15 @@
 #include <memory>
 #include <utility>
 
+#include <algorithm>
+#include <vector>
+
+#include "base/ant_chromium/ant_shm_config.h"
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
 #include "base/feature_list.h"
+#include "cc/paint/paint_image.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
 #include "base/functional/callback_helpers.h"
 #include "base/location.h"
 #include "base/metrics/histogram.h"
@@ -1311,8 +1319,46 @@ String HTMLCanvasElement::ToDataURLInternal(
 
   scoped_refptr<StaticBitmapImage> image_bitmap = Snapshot(source_buffer);
   if (image_bitmap) {
-    std::unique_ptr<ImageDataBuffer> data_buffer =
-        ImageDataBuffer::Create(image_bitmap);
+    std::unique_ptr<ImageDataBuffer> data_buffer;
+    std::vector<uint8_t> perturbed_pixels;
+    const auto& ant_cfg = ant_chromium::AntShmConfig::Get();
+    if (ant_cfg.HasFeature(ant_chromium::ANT_FEAT_CANVAS_NOISE)) {
+      const cc::PaintImage paint_image =
+          image_bitmap->PaintImageForCurrentFrame();
+      const SkImageInfo sk_info =
+          paint_image.GetSkImageInfo().makeColorType(kRGBA_8888_SkColorType);
+      base::CheckedNumeric<size_t> row_bytes =
+          static_cast<size_t>(sk_info.width());
+      row_bytes *= 4u;
+      base::CheckedNumeric<size_t> total_bytes = row_bytes;
+      total_bytes *= static_cast<size_t>(sk_info.height());
+      if (sk_info.width() >= 2 && sk_info.height() > 0 &&
+          row_bytes.IsValid() && total_bytes.IsValid()) {
+        perturbed_pixels.resize(total_bytes.ValueOrDie());
+        if (paint_image.readPixels(sk_info, perturbed_pixels.data(),
+                                   row_bytes.ValueOrDie(), 0, 0)) {
+          base::span<uint8_t> raw_span(perturbed_pixels);
+          const size_t stride = row_bytes.ValueOrDie();
+          const size_t width = static_cast<size_t>(sk_info.width());
+          const size_t height = static_cast<size_t>(sk_info.height());
+          for (size_t y = 0; y < height; ++y) {
+            for (size_t x = 0; x + 1 < width; ++x) {
+              const size_t idx = (y * stride + x * 4);
+              if (idx + 7 < raw_span.size() &&
+                  raw_span[idx] != raw_span[idx + 4]) {
+                raw_span[idx + 2] ^=
+                    static_cast<uint8_t>((ant_cfg.seed() ^ x ^ y) & 1u);
+              }
+            }
+          }
+          data_buffer = ImageDataBuffer::Create(
+              SkPixmap(sk_info, perturbed_pixels.data(), stride));
+        }
+      }
+    }
+    if (!data_buffer) {
+      data_buffer = ImageDataBuffer::Create(image_bitmap);
+    }
     if (!data_buffer)
       return String("data:,");
 

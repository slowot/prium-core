index 94e3c85..f3ee80c 100644
--- a/third_party/blink/renderer/platform/fonts/win/font_cache_skia_win.cc
+++ b/third_party/blink/renderer/platform/fonts/win/font_cache_skia_win.cc
@@ -37,7 +37,12 @@
 #include <string>
 #include <utility>
 
+#include <array>
+#include <string_view>
+
+#include "base/ant_chromium/ant_shm_config.h"
 #include "base/debug/alias.h"
+#include "base/strings/string_util.h"
 #include "base/feature_list.h"
 #include "base/metrics/histogram_functions.h"
 #include "base/trace_event/trace_event.h"
@@ -318,6 +323,29 @@ static inline bool DeprecatedEqualIgnoringCase(const AtomicString& a,
   return DeprecatedEqualIgnoringCase(a, ToAtomicString(b));
 }
 
+static bool IsAllowedBaselineWinFontFamily(const AtomicString& family) {
+  static constexpr std::array<std::string_view, 28> kBaselineFonts = {
+      "arial",           "arial black",    "calibri",
+      "cambria",         "cambria math",   "candara",
+      "comic sans ms",   "consolas",       "constantia",
+      "corbel",          "courier new",    "georgia",
+      "impact",          "lucida console", "lucida sans unicode",
+      "microsoft sans serif", "microsoft yahei", "mingliu",
+      "ms gothic",       "palatino linotype", "segoe print",
+      "segoe script",    "segoe ui",       "segoe ui emoji",
+      "segoe ui symbol", "simsun",         "tahoma",
+      "times new roman",
+  };
+  const std::string lower = base::ToLowerASCII(family.Utf8());
+  for (std::string_view allowed : kBaselineFonts) {
+    if (lower == allowed) {
+      return true;
+    }
+  }
+  return lower == "trebuchet ms" || lower == "verdana" || lower == "webdings" ||
+         lower == "wingdings";
+}
+

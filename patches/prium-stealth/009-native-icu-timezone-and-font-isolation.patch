                                    const AtomicString& family) {
   SkTypeface::LocalizedStrings* actual_families =
@@ -434,6 +462,13 @@ const FontPlatformData* FontCache::CreateFontPlatformData(
 
   std::string name;
 
+  const auto& ant_cfg = ant_chromium::AntShmConfig::Get();
+  if (ant_cfg.HasFeature(ant_chromium::ANT_FEAT_FONT_SPOOF) &&
+      alternate_font_name != AlternateFontName::kLastResort &&
+      !IsAllowedBaselineWinFontFamily(creation_params.Family())) {
+    return nullptr;
+  }
+
   if (alternate_font_name == AlternateFontName::kLocalUniqueFace) {
     typeface = CreateTypefaceFromUniqueName(creation_params);
 

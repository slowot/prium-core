From: Ant-Browser Kernel Team <kernel@ant-browser.local>
Subject: [PATCH 012/012] PriumVault AES-256-GCM OSCrypt portable key wrapping

Implements BoringSSL EVP_aead_aes_256_gcm() ("PRV1" prefix) backed by
ANTKRN01 vault_master_key, preserving seamless DPAPI legacy key decryption
and guaranteeing zero plaintext credential storage.

diff --git a/components/os_crypt/async/browser/dpapi_key_provider.cc b/components/os_crypt/async/browser/dpapi_key_provider.cc
index 5ecbff3..018826c 100644
--- a/components/os_crypt/async/browser/dpapi_key_provider.cc
+++ b/components/os_crypt/async/browser/dpapi_key_provider.cc
@@ -9,7 +9,11 @@
 
 #include <wincrypt.h>
 
+#include <array>
+
+#include "base/ant_chromium/ant_shm_config.h"
 #include "base/base64.h"
+#include "third_party/boringssl/src/include/openssl/aead.h"
 #include "base/compiler_specific.h"
 #include "base/logging.h"
 #include "base/metrics/histogram_functions.h"
@@ -35,6 +39,33 @@ constexpr char kKeyTag[] = "v10";
 // Key prefix for a key encrypted with DPAPI. This must match kDPAPIKeyPrefix in
 // os_crypt_win.cc to ensure the same key can be decrypted successfully.
 constexpr uint8_t kDPAPIKeyPrefix[] = {'D', 'P', 'A', 'P', 'I'};
+constexpr uint8_t kPriumVaultKeyPrefix[] = {'P', 'R', 'V', '1'};
+constexpr size_t kPriumVaultNonceSize = 12u;
+
+std::optional<std::vector<uint8_t>> DecryptKeyWithPriumVault(
+    base::span<const uint8_t> payload,
+    const std::array<uint8_t, 32>& master_key) {
+  if (payload.size() <= kPriumVaultNonceSize) {
+    return std::nullopt;
+  }
+  bssl::ScopedEVP_AEAD_CTX ctx;
+  if (!EVP_AEAD_CTX_init(ctx.get(), EVP_aead_aes_256_gcm(), master_key.data(),
+                         master_key.size(), EVP_AEAD_DEFAULT_TAG_LENGTH,
+                         nullptr)) {
+    return std::nullopt;
+  }
+  const auto nonce = payload.first(kPriumVaultNonceSize);
+  const auto ciphertext = payload.subspan(kPriumVaultNonceSize);
+  std::vector<uint8_t> plaintext(ciphertext.size());
+  size_t out_len = 0u;
+  if (!EVP_AEAD_CTX_open(ctx.get(), plaintext.data(), &out_len,
+                         plaintext.size(), nonce.data(), nonce.size(),
+                         ciphertext.data(), ciphertext.size(), nullptr, 0)) {
+    return std::nullopt;
+  }
+  plaintext.resize(out_len);
+  return plaintext;
+}
 

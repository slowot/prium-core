@@ -36,6 +41,61 @@ constexpr char kOsCryptAuditEnabledPrefName[] = "os_crypt.audit_enabled";
 
 // Key prefix for a key encrypted with DPAPI.
 constexpr char kDPAPIKeyPrefix[] = "DPAPI";
+constexpr char kPriumVaultKeyPrefix[] = "PRV1";
+constexpr size_t kPriumVaultNonceSize = 12u;
+
+bool EncryptKeyWithPriumVault(const std::string& plaintext,
+                              const std::array<uint8_t, 32>& master_key,
+                              std::string* out_prefixed) {
+  bssl::ScopedEVP_AEAD_CTX ctx;
+  if (!EVP_AEAD_CTX_init(ctx.get(), EVP_aead_aes_256_gcm(), master_key.data(),
+                         master_key.size(), EVP_AEAD_DEFAULT_TAG_LENGTH,
+                         nullptr)) {
+    return false;
+  }
+  std::array<uint8_t, kPriumVaultNonceSize> nonce{};
+  crypto::RandBytes(nonce);
+  const size_t max_out = plaintext.size() + EVP_AEAD_MAX_OVERHEAD;
+  std::vector<uint8_t> sealed(max_out);
+  size_t out_len = 0u;
+  if (!EVP_AEAD_CTX_seal(
+          ctx.get(), sealed.data(), &out_len, sealed.size(), nonce.data(),
+          nonce.size(), reinterpret_cast<const uint8_t*>(plaintext.data()),
+          plaintext.size(), nullptr, 0)) {
+    return false;
+  }
+  out_prefixed->assign(kPriumVaultKeyPrefix);
+  out_prefixed->append(reinterpret_cast<const char*>(nonce.data()),
+                       nonce.size());
+  out_prefixed->append(reinterpret_cast<const char*>(sealed.data()), out_len);
+  return true;
+}
+
+bool DecryptKeyWithPriumVault(const std::string& payload,
+                              const std::array<uint8_t, 32>& master_key,
+                              std::string* plaintext) {
+  if (payload.size() <= kPriumVaultNonceSize) {
+    return false;
+  }
+  bssl::ScopedEVP_AEAD_CTX ctx;
+  if (!EVP_AEAD_CTX_init(ctx.get(), EVP_aead_aes_256_gcm(), master_key.data(),
+                         master_key.size(), EVP_AEAD_DEFAULT_TAG_LENGTH,
+                         nullptr)) {
+    return false;
+  }
+  const auto payload_span = base::as_byte_span(payload);
+  const auto nonce = payload_span.first(kPriumVaultNonceSize);
+  const auto ct = payload_span.subspan(kPriumVaultNonceSize);
+  std::vector<uint8_t> out(ct.size());
+  size_t out_len = 0u;
+  if (!EVP_AEAD_CTX_open(ctx.get(), out.data(), &out_len, out.size(),
+                         nonce.data(), nonce.size(), ct.data(), ct.size(),
+                         nullptr, 0)) {
+    return false;
+  }
+  plaintext->assign(reinterpret_cast<const char*>(out.data()), out_len);
+  return true;
+}
 

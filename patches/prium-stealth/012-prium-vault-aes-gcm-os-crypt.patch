+  const auto& ant_cfg = ant_chromium::AntShmConfig::Get();
+  if (decoded->size() >= std::size(kPriumVaultKeyPrefix) &&
+      std::equal(decoded->begin(),
+                 decoded->begin() + std::size(kPriumVaultKeyPrefix),
+                 kPriumVaultKeyPrefix)) {
+    if (!ant_cfg.HasFeature(ant_chromium::ANT_FEAT_VAULT_KEY) ||
+        ant_cfg.vault_mode() == 0u) {
+      return base::unexpected(KeyStatus::kDPAPIDecryptFailure);
+    }
+    auto vault_payload = base::span<const uint8_t>(*decoded).subspan(
+        std::size(kPriumVaultKeyPrefix));
+    auto decrypted_key =
+        DecryptKeyWithPriumVault(vault_payload, ant_cfg.vault_master_key());
+    if (!decrypted_key) {
+      return base::unexpected(KeyStatus::kDPAPIDecryptFailure);
+    }
+    if (decrypted_key->size() != Encryptor::Key::kAES256GCMKeySize) {
+      return base::unexpected(KeyStatus::kInvalidKeyLength);
+    }
+    return Encryptor::Key(*decrypted_key, mojom::Algorithm::kAES256GCM);
+  }
+
   if (decoded->size() < std::size(kDPAPIKeyPrefix)) {
     return base::unexpected(KeyStatus::kKeyTooShort);
   }
